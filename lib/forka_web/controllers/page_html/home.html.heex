<div class="mx-auto max-w-2xl">
  <.card id="home-welcome-card" padding="lg" bordered class="text-center">
    <div class="flex justify-center">
      <.rope tries={6} size={:lg} label={false} />
    </div>

    <%= if @current_player do %>
      <h1 class="mt-6 font-display text-3xl font-bold tracking-tight text-ink text-balance sm:text-4xl">
        Olá, {@current_player.username}!
      </h1>
      <p class="mx-auto mt-4 max-w-prose text-base text-ink-muted text-pretty">
        As salas de jogo chegam em breve. Enquanto isso, você já pode gerenciar sua conta.
      </p>
      <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <.button navigate={~p"/players/settings"} size="lg">
          Minha conta
        </.button>
      </div>
    <% else %>
      <h1 class="mt-6 font-display text-3xl font-bold tracking-tight text-ink text-balance sm:text-4xl">
        Bora jogar Forka!
      </h1>
      <p class="mx-auto mt-4 max-w-prose text-base text-ink-muted text-pretty">
        O jogo multiplayer de adivinhar palavras em português. Crie sua conta ou entre para se preparar para as próximas partidas.
      </p>
      <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <.button navigate={~p"/players/register"} size="lg">
          Criar conta
        </.button>
        <.button navigate={~p"/players/log_in"} variant="secondary" size="lg">
          Entrar
        </.button>
      </div>
    <% end %>
  </.card>
</div>

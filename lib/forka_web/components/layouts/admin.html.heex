<Backpex.HTML.Layout.app_shell fluid={@fluid?}>
  <:topbar>
    <Backpex.HTML.Layout.topbar_branding />
    <Backpex.HTML.Layout.theme_selector
      socket={@socket}
      themes={[
        {"Light", "light"},
        {"Dark", "dark"}
      ]}
    />
    <Backpex.HTML.Layout.topbar_dropdown>
      <:label>
        <label tabindex="0" class="btn btn-square btn-ghost">
          <.icon name="hero-user" class="h-8 w-8" />
        </label>
      </:label>
      <li>
        <.link
          href={~p"/admin/settings"}
          class="flex justify-between text-gray-600 hover:bg-gray-100"
        >
          <p>Settings</p>
          <.icon name="hero-wrench" class="h-5 w-5" />
        </.link>
      </li>
      <li>
        <.link
          href={~p"/admin/log_out"}
          method="delete"
          class="flex justify-between text-red-600 hover:bg-gray-100"
        >
          <p>Logout</p>
          <.icon name="hero-arrow-right-on-rectangle" class="h-5 w-5" />
        </.link>
      </li>
    </Backpex.HTML.Layout.topbar_dropdown>
  </:topbar>
  <:sidebar>
    <Backpex.HTML.Layout.sidebar_item current_url={@current_url} navigate={~p"/admin/games"}>
      <.icon name="hero-book-open" class="h-5 w-5" /> Games
    </Backpex.HTML.Layout.sidebar_item>
    <Backpex.HTML.Layout.sidebar_item current_url={@current_url} navigate={~p"/admin/categories"}>
      <.icon name="hero-book-open" class="h-5 w-5" /> Categories
    </Backpex.HTML.Layout.sidebar_item>
    <Backpex.HTML.Layout.sidebar_item current_url={@current_url} navigate={~p"/admin/words"}>
      <.icon name="hero-book-open" class="h-5 w-5" /> Words
    </Backpex.HTML.Layout.sidebar_item>
    <Backpex.HTML.Layout.sidebar_item current_url={@current_url} navigate={~p"/admin/players"}>
      <.icon name="hero-book-open" class="h-5 w-5" /> Players
    </Backpex.HTML.Layout.sidebar_item>
    <Backpex.HTML.Layout.sidebar_item current_url={@current_url} navigate={~p"/admin/admins"}>
      <.icon name="hero-book-open" class="h-5 w-5" /> Admins
    </Backpex.HTML.Layout.sidebar_item>
  </:sidebar>
  <Backpex.HTML.Layout.flash_messages flash={@flash} />
  {@inner_content}
</Backpex.HTML.Layout.app_shell>
